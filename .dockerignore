# Keep the build context to sources only: deps and artifacts are rebuilt inside the image.
.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
*.md
Makefile

# Dependencies and build output
node_modules
**/node_modules
frontend/dist
.next

# Coverage artifacts
coverage
frontend/coverage
backend/coverage.out
backend/coverage.html

# Local env files (may contain secrets)
.env
.env.*
**/.env
**/.env.*
!frontend/.env.example

# Editor / OS / v0 sandbox noise
.DS_Store
.vscode
.idea
.vercel
.v0-trash
__v0_*
